{
    "namespace": "vulkan",
    "name": "vulkan",
    "description": "PHP-Controllable Vulkan Rendering Extension",
    "author": "Project Saturn Studios, LLC",
    "version": "0.7.0",
    "extra-sources": [
        "src/vulkan-api.c"
    ],
    "extra-cflags": "-I/opt/homebrew/include -I/usr/local/include",
    "extra-libs": "-L/opt/homebrew/lib -L/usr/local/lib -lvulkan",
    "stubs": {
        "path": "ide/%version%/%namespace%/",
        "stubs-run-after-generate": false
    },
    "warnings": {
        "unused-variable": true,
        "unused-variable-external": true,
        "possible-wrong-parameter": true,
        "possible-wrong-parameter-undefined": true,
        "nonexistent-function": true,
        "nonexistent-class": true
    },
    "optimizations": {
        "call-gatherer-pass": false,
        "check-invalid-reads": false,
        "constant-folding": false,
        "local-context-pass": false,
        "static-constant-class-folding": false,
        "static-type-inference": false,
        "static-type-inference-second-pass": false
    }
}
