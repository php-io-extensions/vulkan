# phpize / autoconf / libtool leftovers — never ship these. Ship-ready C
# (.zep.c/.zep.h, kernel/, config.m4, Makefile.frag, staged src/) stays.
ext/.libs/
**/.libs/
ext/autom4te.cache/
ext/build/
ext/modules/
ext/Makefile
ext/Makefile.fragments
ext/Makefile.global
ext/Makefile.objects
ext/config.guess
