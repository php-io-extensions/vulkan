ext/missing
ext/mkinstalldirs
ext/run-tests.php
ext/aclocal.m4
ext/acinclude.m4

# zephir's own phpize wrappers — regenerated on every `zephir generate`,
# stripped by prepare-ext.sh. build-linux.sh and install-macos.sh are the only supported build paths.
ext/install
ext/clean
ext/vulkan.la
ext/vulkan.lo
ext/vulkan.o
ext/vulkan.dep
ext/vulkan.so
ext/**/*.so
ext/**/*.la
ext/**/*.dSYM/
ext/**/*.lo
ext/**/*.o
ext/**/*.la
ext/**/*.dep

