{
    "name": "php-io-extensions/vulkan",
    "type": "php-ext",
    "description": "1:1 PHP bindings of Vulkan: devices, memory, pipelines, commands, swapchains and the Linux dmabuf export",
    "keywords": [
        "vulkan",
        "gpu",
        "moltenvk",
        "php-ext"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        },
        "venusian": {
            "system": {
                "apt": {
                    "build": [
                        "libvulkan-dev"
                    ],
                    "recommends": [
                        "mesa-vulkan-drivers"
                    ]
                },
                "brew": {
                    "build": [
                        "vulkan-loader",
                        "vulkan-headers",
                        "molten-vk"
                    ]
                }
            }
        }
    },
    "php-ext": {
        "extension-name": "vulkan",
        "priority": 30,
        "support-zts": true,
        "support-nts": true,
        "os-families": [
            "linux",
            "darwin"
        ],
        "configure-options": [
            {
                "name": "enable-vulkan",
                "description": "Enable the vulkan extension",
                "needs-value": false
            }
        ]
    }
}
