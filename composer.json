{
    "name": "php-io-extensions/vulkan",
    "type": "php-ext",
    "description": "Vulkan 1.4 core plus WSI, Metal-interop and debug extensions bound 1:1 into PHP (Zephir extension, macOS + Linux)",
    "license": "MIT",
    "version": "0.8.0",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "php-ext": {
        "extension-name": "vulkan",
        "priority": 30,
        "build-path": "ext",
        "support-zts": true,
        "support-nts": true,
        "os-families": ["darwin", "linux"],
        "configure-options": [
            {
                "name": "enable-vulkan",
                "description": "Enable the vulkan extension (macOS + Linux)",
                "needs-value": false
            }
        ]
    }
}
